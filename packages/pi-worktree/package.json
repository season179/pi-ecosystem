{
  "name": "@season179/pi-worktree",
  "version": "26.5.0",
  "description": "A Pi extension that runs sessions inside isolated git worktrees.",
  "type": "module",
  "license": "MIT",
  "author": "Season Saw",
  "homepage": "https://github.com/season179/pi-ecosystem#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/season179/pi-ecosystem.git",
    "directory": "packages/pi-worktree"
  },
  "bugs": {
    "url": "https://github.com/season179/pi-ecosystem/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "worktree",
    "git"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
