{
  "name": "@season179/pi-herdr",
  "version": "26.8.0",
  "description": "Conversational Herdr orchestration with editable worker routing and non-blocking watches.",
  "type": "module",
  "license": "MIT",
  "author": "Season Saw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/season179/pi-ecosystem.git",
    "directory": "packages/pi-herdr"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "herdr",
    "orchestrator",
    "watch"
  ],
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE",
    "skills",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
