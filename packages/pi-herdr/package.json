{
  "name": "@season179/pi-herdr",
  "version": "26.7.0",
  "description": "Non-blocking pi watches over herdr agents, pane output, and bounded commands.",
  "type": "module",
  "license": "MIT",
  "author": "Season Saw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/season179/pi-ecosystem.git",
    "directory": "packages/pi-herdr"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "herdr",
    "orchestrator",
    "watch"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/herdr.js"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
