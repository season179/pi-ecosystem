{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr routing policy v1",
  "description": "No credentials, argv, or executable templates. Loader additionally checks unique profile IDs, known family and fallback references, positive finite share total, and real calendar dates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "historyWindow", "familyShares", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "historyWindow": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "familyShares": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/label" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
    "modelIdentifier": { "type": "string", "pattern": "^[a-zA-Z0-9@][a-zA-Z0-9._/@:-]*$" },
    "label": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "labels": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
    "rank": { "type": "number", "minimum": 0 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "harness", "model", "family", "enabled", "capabilities", "suitability", "preference", "protection", "fallbacks"],
      "properties": {
        "id": { "$ref": "#/$defs/label" },
        "harness": { "enum": ["pi", "claude", "codex"] },
        "provider": { "$ref": "#/$defs/identifier" },
        "model": { "$ref": "#/$defs/modelIdentifier" },
        "family": { "$ref": "#/$defs/label" },
        "enabled": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/labels" },
        "suitability": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": { "easy": { "$ref": "#/$defs/rank" }, "general": { "$ref": "#/$defs/rank" }, "hardest": { "$ref": "#/$defs/rank" } }
        },
        "preference": { "$ref": "#/$defs/rank" },
        "protection": { "enum": ["standard", "claude-auto", "codex-approve-for-me"] },
        "fallbacks": { "$ref": "#/$defs/labels" },
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "date"],
          "properties": {
            "source": { "type": "string", "pattern": "\\S" },
            "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "intelligenceIndex": { "$ref": "#/$defs/rank" },
            "costNote": { "type": "string" },
            "quotaNote": { "type": "string" },
            "capabilityNote": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "harness": { "const": "pi" } } },
          "then": { "required": ["provider"], "properties": { "protection": { "const": "standard" } } },
          "else": { "not": { "required": ["provider"] } }
        },
        {
          "if": { "properties": { "harness": { "const": "claude" } } },
          "then": { "properties": { "protection": { "enum": ["standard", "claude-auto"] } } }
        },
        {
          "if": { "properties": { "harness": { "const": "codex" } } },
          "then": { "properties": { "protection": { "enum": ["standard", "codex-approve-for-me"] } } }
        }
      ]
    }
  }
}
