{
  "name": "@season179/pi-memory",
  "version": "26.8.0",
  "description": "Gives Pi durable, agent-managed memory through remember and recall tools.",
  "type": "module",
  "license": "MIT",
  "author": "Season Saw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/season179/pi-ecosystem.git",
    "directory": "packages/pi-memory"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "agent"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/memory.js"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
