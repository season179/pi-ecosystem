{
  "name": "@season179/pi-readbeam",
  "version": "26.5.0",
  "description": "Segments assistant messages into prose and protected regions, then extracts action-verb and noun-phrase spans for calm summary scanning.",
  "type": "module",
  "license": "MIT",
  "author": "Season Saw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/season179/pi-ecosystem.git",
    "directory": "packages/pi-readbeam"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "readbeam",
    "highlighter",
    "summary",
    "message-replacement"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/readbeam.js"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/extensions/lib/__tests__/segment.test.ts src/extensions/lib/__tests__/analyzer.test.ts",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "compromise": "^14.15.0"
  }
}
